<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ESTADO PRESIONADO -->

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/purple_dark" />

            <corners android:radius="18dp" />

            <padding
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="12dp" />

        </shape>
    </item>

    <!-- ESTADO NORMAL -->

    <item>
        <shape android:shape="rectangle">

            <solid android:color="@color/purple_primary" />

            <corners android:radius="18dp" />

            <stroke
                android:width="1dp"
                android:color="@color/purple_dark" />

            <padding
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="12dp" />

        </shape>
    </item>

</selector>