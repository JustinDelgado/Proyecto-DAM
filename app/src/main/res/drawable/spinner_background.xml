<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ESTADO PRESIONADO / ENFOCADO -->

    <item android:state_focused="true">

        <shape android:shape="rectangle">

            <solid android:color="@android:color/white" />

            <stroke
                android:width="2dp"
                android:color="@color/purple_primary" />

            <corners android:radius="16dp" />

            <padding
                android:left="16dp"
                android:top="10dp"
                android:right="16dp"
                android:bottom="10dp" />

        </shape>

    </item>

    <!-- ESTADO NORMAL -->

    <item>

        <shape android:shape="rectangle">

            <solid android:color="@android:color/white" />

            <stroke
                android:width="1dp"
                android:color="#D6D6D6" />

            <corners android:radius="16dp" />

            <padding
                android:left="16dp"
                android:top="10dp"
                android:right="16dp"
                android:bottom="10dp" />

        </shape>

    </item>

</selector>