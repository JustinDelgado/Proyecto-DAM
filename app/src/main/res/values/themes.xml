<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================================================= -->
    <!-- TEMA BASE -->
    <!-- ========================================================= -->

    <style name="Base.Theme.Poyecto" parent="Theme.Material3.Light.NoActionBar">

        <!-- COLORES PRINCIPALES -->

        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryContainer">@color/purple_light_card</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- STATUS BAR -->

        <item name="android:statusBarColor">@color/purple_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- NAVIGATION BAR -->

        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- FONDO APP -->

        <item name="android:windowBackground">@color/bg_app</item>

        <!-- TOOLBAR -->

        <item name="toolbarStyle">@style/CustomToolbar</item>

        <!-- BOTONES -->

        <item name="materialButtonStyle">@style/CustomButton</item>

        <!-- INPUTS -->

        <item name="textInputStyle">@style/CustomTextInputLayout</item>

    </style>

    <!-- ========================================================= -->
    <!-- TEMA PRINCIPAL -->
    <!-- ========================================================= -->

    <style name="Theme.Poyecto" parent="Base.Theme.Poyecto" />

    <!-- ========================================================= -->
    <!-- TOOLBAR -->
    <!-- ========================================================= -->

    <style name="CustomToolbar" parent="Widget.Material3.Toolbar">

        <item name="android:background">@color/purple_primary</item>

        <item name="titleTextColor">@android:color/white</item>

        <item name="subtitleTextColor">@android:color/white</item>

    </style>

    <!-- ========================================================= -->
    <!-- BOTONES -->
    <!-- ========================================================= -->

    <style name="CustomButton" parent="Widget.Material3.Button">

        <item name="cornerRadius">18dp</item>

        <item name="android:textAllCaps">false</item>

        <item name="android:textStyle">bold</item>

        <item name="android:textSize">15sp</item>

    </style>

    <!-- ========================================================= -->
    <!-- INPUT LAYOUT -->
    <!-- ========================================================= -->

    <style name="CustomTextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>

        <item name="boxStrokeColor">@color/purple_primary</item>

        <item name="hintTextColor">@color/text_secondary</item>

    </style>

</resources>